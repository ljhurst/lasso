aws_region   = "us-east-1"
environment  = "prod"
project_name = "lasso"

lambda_package_path = "../dist/lasso.zip"

# Look up the current version before setting this — see the description
# on var.lwa_layer_arn in variables.tf.
lwa_layer_arn = "arn:aws:lambda:us-east-1:753240598075:layer:LambdaAdapterLayerArm64:<version>"

# Placeholder until the domain/DNS decision (DESIGN §8) is made.
issuer = "https://lasso.example.com"
